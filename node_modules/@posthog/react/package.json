{
  "name": "@posthog/react",
  "version": "1.11.3",
  "bugs": {
    "url": "https://github.com/PostHog/posthog-js/issues"
  },
  "description": "Provides components and hooks for React integrations of PostHog.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PostHog/posthog-js.git",
    "directory": "packages/react"
  },
  "author": "engineering@posthog.com",
  "license": "MIT",
  "homepage": "https://posthog.com/docs/libraries/react",
  "main": "dist/umd/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "files": [
    "dist",
    "src",
    "surveys",
    "slim"
  ],
  "peerDependencies": {
    "@types/react": ">=16.8.0",
    "posthog-js": ">=1.257.2",
    "react": ">=16.8.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/preset-env": "^7.27.1",
    "@babel/preset-react": "^7.27.1",
    "@babel/preset-typescript": "^7.27.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.7",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tsdown": "0.22.14",
    "tslib": "^2.5.0",
    "typescript": "7.0.2",
    "jsdom": "^26.1.0",
    "vitest": "^1.6.1",
    "@ampproject/remapping": "2.3.0",
    "typescript-legacy": "npm:typescript@5.8.2",
    "posthog-js": "^1.435.1"
  },
  "scripts": {
    "check-types": "tsc --noEmit --project tsconfig.json",
    "clean": "rimraf dist",
    "build": "rimraf dist ../browser/react/dist ../browser/react/src && tsdown && pnpm check:build-output",
    "dev": "rimraf dist ../browser/react/dist ../browser/react/src && tsdown --watch",
    "check:build-output": "es-check --module es5 'dist/esm/**/*.js' && es-check es5 'dist/umd/**/*.js' && node scripts/check-build-output.mjs",
    "test:unit": "vitest run",
    "lint": "oxlint --report-unused-disable-directives-severity error src",
    "test:debug": "vitest run",
    "package": "pnpm pack --out $PACKAGE_DEST/%s.tgz"
  }
}